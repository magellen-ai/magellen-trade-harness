# Repo-local env for Claude Code proxy/auth (gitignored).
# Copy to `.env` and fill. Used by `harness instance sync-settings`
# to expand $VAR in instance config.yaml → cc-env → .claude/settings.json.

ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional alternate auth style for some proxies:
# ANTHROPIC_AUTH_TOKEN=
