# Repo-local env for harness runtimes (gitignored).
# Copy to `.env` and fill. Used by `harness instance sync-settings` /
# launch to expand $VAR in instance env maps (`cc-env`, `pi-env`, …).

# Claude Code (claude-code harness → materialize .claude/settings.json)
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional alternate auth style for some proxies:
# ANTHROPIC_AUTH_TOKEN=

# Pi (pi harness → models.json $AIPROXY_API_KEY via process env)
AIPROXY_API_KEY=

# Optional: investment-search web search (Tavily). Quote via yfinance needs no key.
# TAVILY_API_KEY=
